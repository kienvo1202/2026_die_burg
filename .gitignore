# ---------------------------------------------------------------------------
# Universal
# ---------------------------------------------------------------------------

# Secrets. Ignored in the very first commit, before anyone creates the file:
# a secret that reaches git history stays there even after it is deleted.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
secrets.json

# Scratch space and logs
tmp/
*.log

# OS and editor junk
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Personal Claude Code permissions. The shared .claude/settings.json is committed.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Node / Astro
# ---------------------------------------------------------------------------
node_modules/
dist/
coverage/
# Astro's generated types and cache
.astro/

# ---------------------------------------------------------------------------
# Capacitor (Phase 2). Native projects are committed; their build output is not.
# ---------------------------------------------------------------------------
# ios/App/Pods/
# android/.gradle/
# android/app/build/
