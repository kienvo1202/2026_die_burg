---
// The frame every page sits in: fonts, tokens, theme, navigation and footer.
// Phones get a bottom tab bar (the pattern the Capacitor app will keep);
// wider screens get links in the header.
import "@fontsource-variable/eb-garamond";
import "@fontsource-variable/eb-garamond/wght-italic.css";
import "@fontsource/im-fell-english";
import "@fontsource/im-fell-english/400-italic.css";
import "@fontsource/im-fell-english-sc";
import "@fontsource/cinzel-decorative/400.css";
import "@fontsource/cinzel-decorative/700.css";
import "../design/tokens.css";
import "../design/base.css";
import Tower from "../design/ornaments/Tower.astro";
import Icon from "../components/ui/Icon.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import { ICON_BOOK, ICON_MAP, ICON_QUILL } from "../design/ornaments/Icons.ts";
import { SITE_NAME } from "../lib/site.ts";
import { THEME_KEY } from "../lib/theme.ts";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "A German course you read, one lesson at a time." } = Astro.props;
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;

// Which section of the book we are in, for the "current page" marker.
const path = Astro.url.pathname;
const section =
  path === "/"
    ? "home"
    : path.startsWith("/words")
      ? "words"
      : path.startsWith("/map")
        ? "map"
        : path.startsWith("/course") || path.startsWith("/lessons") || path.startsWith("/tales")
          ? "course"
          : "";
const current = (name: string) => (section === name ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <!-- Apply a saved theme before first paint, so the page never flashes the wrong one. -->
    <script is:inline define:vars={{ themeKey: THEME_KEY }}>
      try {
        const saved = localStorage.getItem(themeKey);
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {
        // Storage blocked: follow the system theme.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the text</a>
    <header class="masthead">
      <a class="brand" href="/" aria-label={`${SITE_NAME}: home`}>
        <Tower class="brand-mark" />
        <span class="brand-name">{SITE_NAME}</span>
      </a>
      <nav class="top-nav" aria-label="Main">
        <a href="/course" aria-current={current("course")}>Course</a>
        <a href="/map" aria-current={current("map")}>Map</a>
        <a href="/words" aria-current={current("words")}>Words</a>
      </nav>
      <ThemeToggle />
    </header>

    <main id="main" class="page-turn">
      <slot />
    </main>

    <footer class="colophon">
      <p>Your progress is saved on this device only.</p>
      <p><a href="/design">How this book is designed</a></p>
    </footer>

    <nav class="tab-bar" aria-label="Main">
      <a href="/" aria-current={current("home")}>
        <Tower class="tab-icon tower" />
        <span>Home</span>
      </a>
      <a href="/course" aria-current={current("course")}>
        <Icon icon={ICON_BOOK} class="tab-icon" />
        <span>Course</span>
      </a>
      <a href="/map" aria-current={current("map")}>
        <Icon icon={ICON_MAP} class="tab-icon" />
        <span>Map</span>
      </a>
      <a href="/words" aria-current={current("words")}>
        <Icon icon={ICON_QUILL} class="tab-icon" />
        <span>Words</span>
      </a>
    </nav>

    <p class="voice-note" role="status" hidden data-voice-note>
      Your device has no German voice installed, so listen buttons may sound wrong or stay
      silent. The text works the same.
    </p>
  </body>
</html>

<style>
  body {
    --tab-bar-height: 3.75rem;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) 0 env(safe-area-inset-left);
  }

  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100%;
    padding: var(--space-2) var(--space-4);
    background: var(--color-card);
    z-index: 10;
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  .masthead {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border-hair);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-right: auto;
    min-height: var(--tap-min);
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand-mark {
    width: 1.5rem;
    height: 1.75rem;
    color: var(--color-rubric);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .top-nav {
    display: none;
    gap: var(--space-2);
  }

  .top-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 var(--space-3);
    font-family: var(--font-label);
    letter-spacing: var(--tracking-label);
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .top-nav a[aria-current="page"] {
    color: var(--color-rubric);
    border-bottom-color: var(--color-rubric);
  }

  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-7);
  }

  .colophon {
    max-width: 72rem;
    margin: 0 auto;
    /* leave room for the tab bar on phones */
    padding: var(--space-5) var(--space-4)
      calc(var(--tab-bar-height) + var(--space-5) + env(safe-area-inset-bottom));
    border-top: var(--border-hair);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    text-align: center;
  }

  .colophon p {
    margin: 0 0 var(--space-1);
  }

  .tab-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--color-card);
    border-top: var(--border-gilt);
    box-shadow: var(--shadow-card);
  }

  .tab-bar a {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2px;
    min-height: var(--tab-bar-height);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .tab-bar a[aria-current="page"] {
    color: var(--color-rubric);
  }

  .tab-bar :global(.tab-icon) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .tab-bar :global(.tower) {
    width: 1.25rem;
  }

  @media (min-width: 48rem) {
    .top-nav {
      display: flex;
    }

    .tab-bar {
      display: none;
    }

    .colophon {
      padding-bottom: var(--space-6);
    }
  }

  .voice-note {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: calc(var(--tab-bar-height) + var(--space-3) + env(safe-area-inset-bottom));
    z-index: 6;
    max-width: 32rem;
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    background: var(--color-card);
    border: var(--border-hair);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 48rem) {
    .voice-note {
      bottom: var(--space-4);
    }
  }
</style>
