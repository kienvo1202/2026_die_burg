---
// A small "listen" button that reads the given German text aloud via speak().
// One click handler serves every button on the page (event delegation), so the
// script ships once however many buttons there are.
import Icon from "../ui/Icon.astro";
import { ICON_LISTEN } from "../../design/ornaments/Icons.ts";

interface Props {
  text: string;
}
const { text } = Astro.props;

// The button comes last in this file, with no newline after it: anything after it would
// render as a space before the punctuation that follows a listen button in prose.
---

<script>
  import { speak } from "../../lib/speech.ts";

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLElement>("[data-say]");
    if (!button) return;

    const result = speak(button.dataset.say ?? "");
    if (result === "spoken") return;
    const note = document.querySelector<HTMLElement>("[data-voice-note]");
    if (note) note.hidden = false;
  });
</script>

<style>
  /* The button is only as wide as its icon, so punctuation after it sits close, as
     after a word. An invisible ::after extends the tap area to at least --tap-min. */
  .listen {
    position: relative;
    display: inline-grid;
    place-items: center;
    vertical-align: -0.2em;
    width: 1.5em;
    height: 1.5em;
    margin: 0 0.1em 0 0.25em;
    padding: 0;
    color: var(--color-gold-text);
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .listen::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--tap-min);
    height: var(--tap-min);
    transform: translate(-50%, -50%);
  }

  .listen:hover {
    color: var(--color-rubric);
  }
</style>

<button type="button" class="listen" data-say={text}>
  <Icon icon={ICON_LISTEN} />
  <span class="visually-hidden">Listen: <span lang="de">{text}</span></span>
</button>