---
// A fixed phrase learned whole: what it literally says, and what it means.
//   <Chunk de="Wie geht's?" literal="How goes it?" means="How are you?" />
import Listen from "./Listen.astro";

interface Props {
  de: string;
  literal: string;
  means: string;
}
const { de, literal, means } = Astro.props;
---

<div class="chunk">
  <p class="phrase"><span lang="de">{de}</span><Listen text={de} /></p>
  <dl>
    <div><dt class="label">Literally</dt><dd>{literal}</dd></div>
    <div><dt class="label">Means</dt><dd>{means}</dd></div>
  </dl>
  <slot />
</div>

<style>
  .chunk {
    margin: var(--space-5) 0;
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-rubric);
  }

  .phrase {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
  }

  dl div {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  dt {
    font-size: var(--text-xs);
  }

  dd {
    margin: 0;
  }
</style>
