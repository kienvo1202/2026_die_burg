---
// A red wax seal pressed with the tower: marks a finished lesson.
import Tower from "../../design/ornaments/Tower.astro";

interface Props {
  label?: string;
  size?: "sm" | "md" | "lg";
}
const { label = "Finished", size = "md" } = Astro.props;
---

<span class:list={["seal", size]} role="img" aria-label={label}>
  <svg class="wax" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M47.1 24.0 L47.7 26.1 L46.2 27.9 L45.8 29.9 L45.6 31.9 L44.2 33.4 L43.1 35.0 L41.4 36.2 L38.9 36.5 L38.1 38.1 L38.3 41.1 L37.3 43.0 L35.8 44.5 L34.0 45.5 L31.6 44.8 L29.6 44.8 L27.9 46.1 L25.9 45.6 L24.0 44.3 L22.2 44.4 L20.4 44.5 L18.3 45.1 L15.7 46.8 L13.7 46.2 L12.7 43.6 L11.4 41.9 L10.1 40.5 L9.2 38.8 L7.6 37.8 L6.5 36.3 L6.5 34.1 L4.8 33.0 L2.0 32.0 L0.9 30.2 L0.4 28.2 L0.9 26.0 L3.1 24.0 L3.9 22.2 L2.9 20.3 L3.3 18.5 L4.3 16.8 L4.3 14.8 L5.0 13.0 L5.4 11.0 L5.2 8.2 L7.0 7.0 L10.1 7.4 L12.1 7.0 L13.8 6.4 L15.4 5.6 L16.5 3.5 L18.2 2.3 L20.3 2.8 L22.1 1.8 L24.0 0.3 L26.1 0.5 L28.0 1.2 L29.7 2.6 L30.8 5.4 L32.3 6.3 L34.7 5.4 L36.7 5.9 L38.4 6.8 L40.3 7.7 L41.3 9.5 L42.5 11.0 L44.6 12.1 L44.7 14.4 L43.4 16.9 L43.4 18.8 L43.8 20.5 L44.7 22.2 Z"
    ></path>
    <circle cx="24" cy="24" r="15.5" fill="none" stroke="currentColor" stroke-width="1.2" class="rim"></circle>
  </svg>
  <Tower class="mark" />
</span>

<style>
  .seal {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    color: var(--color-rubric);
    filter: drop-shadow(0 1px 1px var(--color-shadow));
  }

  .sm {
    width: 1.75rem;
    height: 1.75rem;
  }

  .md {
    width: 2.75rem;
    height: 2.75rem;
  }

  .lg {
    width: 4.5rem;
    height: 4.5rem;
  }

  .wax {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }

  /* the pressed rim and tower read as shallower wax: page colour, faintly */
  .rim {
    stroke: var(--color-on-rubric);
    opacity: 0.35;
  }

  .mark {
    grid-area: 1 / 1;
    width: 42%;
    height: 42%;
    color: var(--color-on-rubric);
    opacity: 0.8;
  }
</style>
