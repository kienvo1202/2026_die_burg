---
// An opening paragraph with an illuminated initial: the first letter set large in the
// display face (Cinzel Decorative), rubric red, in a gilt-framed box. The letter stays
// part of the text, so screen readers and search read the word normally.
---

<p class="initial"><slot /></p>

<style>
  .initial::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: calc(var(--text-base) * 2.9);
    font-weight: 700;
    line-height: 1;
    color: var(--color-rubric);
    background: var(--color-card);
    border: var(--border-gilt);
    padding: 0.1em 0.16em 0.04em;
    margin: 0.12em var(--space-3) 0 0;
  }
</style>
