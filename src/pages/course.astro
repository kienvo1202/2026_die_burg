---
// The table of contents: every level as a chapter, every lesson with its state.
// Finished (seal) and "you are here" (ribbon) come from this device's progress, so a
// small script marks them after the page loads.
import Base from "../layouts/Base.astro";
import Ribbon from "../components/ui/Ribbon.astro";
import Seal from "../components/ui/Seal.astro";
import { loadCourse } from "../lib/course.ts";

const { levels, lessons } = await loadCourse();
const lessonsByLevel = new Map(levels.map((level) => [level.id, lessons.filter((lesson) => lesson.level.id === level.id)]));
---

<Base title="Course" description="Every level and lesson of Die Burg, from A1 towards C2.">
  <header class="intro">
    <p class="label">The course</p>
    <h1>From first words to fluent German</h1>
    <p>
      Twelve levels, from A1 to C2, each a chapter of short lessons. Read them in order: every
      lesson builds on the ones before it. Lessons are added level by level.
    </p>
  </header>

  {
    levels.map((level) => (
      <section class="level" id={level.id} aria-labelledby={`${level.id}-title`}>
        <header class="level-head">
          <p class="level-name">{level.name}</p>
          <div>
            <h2 id={`${level.id}-title`}>{level.title}</h2>
            <p class="level-can-do">{level.canDo}</p>
          </div>
        </header>
        {lessonsByLevel.get(level.id)!.length === 0 ? (
          <p class="being-written">The lessons for this level are being written.</p>
        ) : (
          <ol class="lessons">
            {lessonsByLevel.get(level.id)!.map((lesson) => (
              <li class:list={["lesson", { written: lesson.entry }]} data-lesson={lesson.entry ? lesson.id : undefined}>
                <span class="mark">
                  <span class="number">{lesson.number}</span>
                  <span class="seal">
                    <Seal size="sm" label="Finished" />
                  </span>
                  <span class="ribbon">
                    <Ribbon label="Read this next" />
                  </span>
                </span>
                <span class="text">
                  {lesson.entry ? (
                    <a class="title" href={`/lessons/${lesson.id}`}>
                      {lesson.title}
                    </a>
                  ) : (
                    <span class="title">{lesson.title}</span>
                  )}
                  <span class="can-do">
                    {lesson.canDo}
                    {!lesson.entry && <span class="soon"> · coming soon</span>}
                  </span>
                </span>
              </li>
            ))}
          </ol>
        )}
      </section>
    ))
  }
</Base>

<script>
  import { loadProgress } from "../lib/progress.ts";

  const finished = new Set(loadProgress().finished);
  let ribbonPlaced = false;
  for (const row of document.querySelectorAll<HTMLElement>("[data-lesson]")) {
    const id = row.dataset.lesson ?? "";
    if (finished.has(id)) {
      row.classList.add("is-finished");
    } else if (!ribbonPlaced) {
      row.classList.add("is-next"); // the first written lesson not yet finished
      ribbonPlaced = true;
    }
  }
</script>

<style>
  .intro {
    max-width: var(--measure);
    margin: 0 auto var(--space-6);
  }

  .level {
    max-width: 48rem;
    margin: 0 auto var(--space-7);
  }

  .level-head {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: var(--border-gilt);
  }

  .level-name {
    flex: none;
    margin: 0;
    /* not the display face: its "1" looks like a capital I ("A1.1" read "AI.I") */
    font-family: var(--font-body);
    font-weight: 600;
    font-variant-numeric: lining-nums;
    font-size: var(--text-xl);
    color: var(--color-rubric);
    line-height: 1;
  }

  .level-head h2 {
    margin: 0;
  }

  .level-can-do {
    margin: var(--space-1) 0 0;
    color: var(--color-ink-soft);
    font-style: italic;
  }

  .being-written {
    margin-top: var(--space-3);
    color: var(--color-ink-soft);
  }

  .lessons {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lesson {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    min-height: calc(var(--tap-min) + var(--space-3));
    padding: var(--space-2) 0;
    border-bottom: var(--border-hair);
  }

  .mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
  }

  .mark > * {
    grid-area: 1 / 1;
  }

  .number {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
  }

  .seal,
  .ribbon {
    display: none;
  }

  .is-finished .number,
  .is-next .number {
    display: none;
  }

  .is-finished .seal,
  .is-next .ribbon {
    display: block;
  }

  .text {
    display: grid;
  }

  .title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    color: var(--color-ink);
  }

  a.title {
    text-decoration-color: var(--color-rule);
  }

  .lesson:not(.written) .title,
  .lesson:not(.written) .number {
    color: var(--color-ink-soft);
  }

  .can-do {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .soon {
    font-style: italic;
  }
</style>
