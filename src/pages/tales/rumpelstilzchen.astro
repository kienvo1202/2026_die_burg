---
// A sample tale (ADR 0007, proposed): a short story made of words the reader already
// knows, read between lessons. One hand-made sample, so it has no collection or course
// map entry yet; its words are checked by hand against `ledger-report a1-03`.
import Base from "../../layouts/Base.astro";
import Initial from "../../components/ui/Initial.astro";
import Check from "../../components/lesson/Check.astro";
import Chunk from "../../components/lesson/Chunk.astro";
import Dialogue from "../../components/lesson/Dialogue.astro";
import Line from "../../components/lesson/Line.astro";
import Say from "../../components/lesson/Say.astro";
import WordList from "../../components/lesson/WordList.astro";
import Tale, { frontmatter } from "../../drafts/tales/rumpelstilzchen.mdx";

const components = { Check, Chunk, Dialogue, Initial, Line, Say, WordList };
---

<Base title={frontmatter.title} description="A tale from the Brothers Grimm, told with the German of lessons 1 and 2.">
  <article class="tale">
    <header class="tale-head">
      <p class="label"><a href="/course#a1-1">A1.1 · First conversations</a> · A tale, after lesson 2</p>
      <h1>{frontmatter.title}</h1>
      <p class="minutes">About {frontmatter.minutes} minutes · for enjoying, not studying</p>
    </header>

    <Tale components={components} />
  </article>

  <nav class="turn-page" aria-label="Lessons">
    <a class="turn" href="/lessons/a1-02">
      <span class="label">← Back to</span>
      <span class="turn-title">Where are you from?</span>
    </a>
  </nav>
</Base>

<style>
  .tale {
    max-width: var(--measure);
    margin: 0 auto;
  }

  .tale-head {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-gilt);
  }

  .tale-head .label a {
    color: inherit;
    text-decoration: none;
  }

  .tale-head h1 {
    margin-top: var(--space-2);
  }

  .minutes {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    font-style: italic;
  }

  .tale :global(h2) {
    margin-top: var(--space-7);
  }

  .turn-page {
    max-width: var(--measure);
    margin: var(--space-7) auto 0;
  }

  .turn {
    display: inline-grid;
    gap: var(--space-1);
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-4);
    color: var(--color-ink);
    text-decoration: none;
    border: var(--border-hair);
    border-radius: var(--radius-md);
  }

  .turn-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }
</style>
