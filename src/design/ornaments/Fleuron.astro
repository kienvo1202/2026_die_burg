---
// A printer's fleuron between two hairlines: the divider between sections.
// Coloured by the surrounding text colour (currentColor), set by the caller.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 240 24" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
    <path d="M10 12 H97" />
    <path d="M143 12 H230" />
    <path d="M112 12 C108 6 102 6 100.5 10.2" />
    <path d="M112 12 C108 18 102 18 100.5 13.8" />
    <path d="M128 12 C132 6 138 6 139.5 10.2" />
    <path d="M128 12 C132 18 138 18 139.5 13.8" />
    <path d="M120 3.5 L128.5 12 L120 20.5 L111.5 12 Z" />
  </g>
  <g fill="currentColor">
    <path d="M120 8.2 L123.8 12 L120 15.8 L116.2 12 Z" />
    <circle cx="7" cy="12" r="1.6" />
    <circle cx="233" cy="12" r="1.6" />
    <circle cx="99.5" cy="12" r="1.3" />
    <circle cx="140.5" cy="12" r="1.3" />
  </g>
</svg>
