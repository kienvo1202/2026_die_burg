{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    // Imports say ".ts" so Node can run the same files directly in tests
    // (node --test strips the types; it does not rewrite import paths).
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
